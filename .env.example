# StudyHawk. Copy to .env and fill in. Every replica uses the same file
# (only NODE_ID changes per machine).
#
# Local development needs none of this: `npm run dev` in backend/ starts an
# embedded PostgreSQL in data/dev-postgres, generates a MASTER_KEY and seeds
# admin/admin and user/user. Set DATABASE_URL to use your own Postgres instead.

# --- Database (required). External PostgreSQL 14+, shared by every replica.
DATABASE_URL=postgres://studyhawk:password@db.host:5432/studyhawk
# TLS to the database: false, true (checks the certificate; a private CA goes in DB_SSL_CA) or no-verify.
DB_SSL=false
# DB_SSL_CA=/run/secrets/db-ca.pem
DB_POOL_MAX=10

# --- Secrets (required). 32 bytes in base64, IDENTICAL on every replica.
# Encrypts SMTP passwords, Canvas tokens, SSO passwords and API keys in the DB.
# Generate with: openssl rand -base64 32
# Losing it means every stored secret has to be entered again.
MASTER_KEY=

# --- First admin. Only used when the database has no admin yet; after that,
# edit the account in the admin panel (these values are never re-applied).
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@studyhawk.app
# At least 12 characters of your own: production refuses a placeholder. Remove it after the first boot.
ADMIN_PASSWORD=

# --- Public address, used in email links. No trailing slash.
PUBLIC_URL=https://studyhawk.app

# --- This replica's name in the admin panel (default: container hostname).
# NODE_ID=node-1

# --- Defaults (each can be changed later in Admin -> Settings)
LANGUAGE=en
SESSION_TTL_HOURS=168
# Cookies are Secure (and __Host-) whenever PUBLIC_URL is https. Only set this to override.
# COOKIE_SECURE=true
# Reverse proxies allowed to report the client IP: the exact address of the proxy in front
# (e.g. Nginx Proxy Manager's container IP), or uniquelocal, or IPs/CIDRs. Not `cloudflare` behind a Tunnel.
TRUST_PROXY=uniquelocal
# Behind Cloudflare: the visitor's real IP, set by Cloudflare itself (see SECURITY.md).
# CLIENT_IP_HEADER=cf-connecting-ip
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
# Unverified sign-ups are deleted after this many hours.
VERIFICATION_TTL_HOURS=72

# --- Sandbox (phase 4)
# SANDBOX_IMAGE=ghcr.io/pixlgalaxy/studyhawk-sandbox:latest
# Host path where the shared storage is mounted (the same storage as /data).
# SANDBOX_DATA_HOST_PATH=/mnt/studyhawk-nfs/data

# SMTP, institutions, models, push and billing are set in the admin panel.
