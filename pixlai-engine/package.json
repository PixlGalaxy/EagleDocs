{
  "name": "pixlai-engine",
  "version": "1.0.0",
  "description": "PixlAI-Engine: a multi-user agent engine with tools, steering, approvals, subagents and cron jobs. Storage and models are plugged in through ports.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2"
  },
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=20.3"
  }
}
